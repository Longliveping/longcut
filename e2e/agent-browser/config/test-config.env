# config/test-config.env
# Test environment configuration for agent-browser tests

# Base URL (localhost or staging)
export TEST_BASE_URL="${TEST_BASE_URL:-http://localhost:3000}"

# Display mode (false=headed for debugging, true=headless for CI)
# Note: agent-browser uses --headed flag, so we invert the logic
export HEADLESS="${HEADLESS:-}"  # Empty means headed (visible), set to "--headed false" for headless

# Test user credentials
export TEST_USER_EMAIL="${TEST_USER_EMAIL:-test@example.com}"
export TEST_USER_PASSWORD="${TEST_USER_PASSWORD:-TestPass123!}"

# Test video URLs (short, medium, long for different scenarios)
# dQw4w9WgXcQ - Rick Roll (short, reliable)
# jNQXAC9IVRw - Me at the zoo (first YouTube video, medium)
export TEST_VIDEO_SHORT="${TEST_VIDEO_SHORT:-https://www.youtube.com/watch?v=dQw4w9WgXcQ}"
export TEST_VIDEO_MEDIUM="${TEST_VIDEO_MEDIUM:-https://www.youtube.com/watch?v=jNQXAC9IVRw}"

# Screenshot directory
export SCREENSHOT_DIR="${SCREENSHOT_DIR:-./test-results/agent-browser/screenshots}"

# Test timeouts (in milliseconds for agent-browser wait)
# Note: agent-browser has a ~5 second limit per wait call
export WAIT_LOAD="${WAIT_LOAD:-5000}"   # Max per wait is ~5 seconds
export WAIT_ELEMENT="${WAIT_ELEMENT:-5000}"
export WAIT_SHORT="${WAIT_SHORT:-3000}"
export WAIT_ITERATIONS="${WAIT_ITERATIONS:-18}"  # 18 * 5s = 90s total for analysis

# Feature flags
export SKIP_AUTH_TESTS="${SKIP_AUTH_TESTS:-false}"
export SKIP_VIDEO_TESTS="${SKIP_VIDEO_TESTS:-false}"
export SKIP_CHAT_TESTS="${SKIP_CHAT_TESTS:-false}"
