{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "validate-env": "tsx scripts/validate-env.ts",
    "stripe:smoke": "node scripts/stripe-smoke.mjs",
    "stripe:setup-portal": "tsx scripts/setup-stripe-portal.ts",
    "stripe:create-prices": "tsx scripts/create-new-prices.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:sign-in": "playwright test e2e/auth/tests/sign-in.spec.ts",
    "test:e2e:sign-up": "playwright test e2e/auth/tests/sign-up.spec.ts",
    "test:e2e:sign-out": "playwright test e2e/auth/tests/sign-out.spec.ts",
    "test:e2e:session": "playwright test e2e/auth/tests/session-persistence.spec.ts",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=\"Mobile Chrome\"",
    "test:e2e:report": "playwright show-report test-results/html-report",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test": "cross-env NODE_ENV=test vitest",
    "test:agent": "cd e2e/agent-browser && ./run-all.sh",
    "test:agent:auth": "cd e2e/agent-browser && ./tests/03-auth-flows.sh",
    "test:agent:chat": "cd e2e/agent-browser && ./tests/02-ai-chat.sh",
    "test:agent:video": "cd e2e/agent-browser && ./tests/01-video-analysis.sh",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "test:run": "cross-env NODE_ENV=test vitest run",
    "test:ui": "cross-env NODE_ENV=test vitest --ui"
  },
  "dependencies": {
